{
  "id": "conv_p008",
  "title": "Pricing \u00e2\u20ac\u201d add-on max quantity enforced: clamps 5 extra patty to max=3",
  "category": "pricing",
  "tags": [
    "llm",
    "pricing",
    "add_on",
    "quantity_limit",
    "pickup"
  ],
  "notes": "Customer asks for 5 extra patty. DET detects 'extra patty' as paid add-on conflict and yields to LLM. LLM returns quantity=5. Pipeline clamps to max_qty=3. 3 \u00c3\u2014 R25 = R75. unit_price=7500+7500=15000. subtotal=15000.",
  "turns": [
    {
      "message": "Loaded Smash Burger with 5 extra patty",
      "expect": {
        "state": "CONFIRMING_ORDER",
        "cart": [
          {
            "name": "Loaded Smash Burger",
            "quantity": 1
          }
        ]
      }
    },
    {
      "message": "Yes",
      "expect": {
        "state": "CHOOSING_ORDER_MODE"
      }
    },
    {
      "message": "Pickup",
      "expect": {
        "state": "COLLECTING_DETAILS"
      }
    },
    {
      "message": "Thabo",
      "expect": {
        "state": "COLLECTING_DETAILS"
      }
    },
    {
      "message": "0867654321",
      "expect": {
        "state": "COLLECTING_DETAILS",
        "response_contains": [
          "special instructions"
        ]
      }
    },
    {
      "message": "skip",
      "expect": {
        "state": "ORDER_PLACED",
        "cart": []
      }
    }
  ],
  "final_order": {
    "items": [
      {
        "name": "Loaded Smash Burger",
        "quantity": 1
      }
    ],
    "subtotal_cents": 15000,
    "total_cents": 15000,
    "order_mode": "PICKUP",
    "customer_name": "Thabo"
  }
}