{
  "id": "conv_302",
  "title": "Options — full flow: DET asks required option, DET resolves deterministically, order placed",
  "category": "options",
  "tags": ["det", "options", "required_options", "pickup", "cx"],

  "notes": "Updated 2026-10-26 (BUG-0159): resolving a single pending item's required option is now deterministic (matched directly against the item's own options_json, no LLM call) -- 'Oat milk please' used to need a scripted LLM response; it no longer reaches the LLM at all, so the 'llm' key here is now dead and was removed. See KNOWN_BUGS.md BUG-0159.",

  "turns": [
    {
      "message": "Can I get a cappuccino",
      "expect": {
        "state": "CHOOSING_OPTIONS",
        "cart": [],
        "response_contains": ["milk", "cappuccino", "oat", "soy"]
      }
    },
    {
      "message": "Oat milk please",
      "expect": {
        "state": "CONFIRMING_ORDER",
        "cart": [{"name": "Cappuccino", "quantity": 1, "special_instructions": "oat milk"}]
      }
    },
    {
      "message": "Yes",
      "expect": {
        "state": "CHOOSING_ORDER_MODE"
      }
    },
    {
      "message": "Pickup",
      "expect": {
        "state": "COLLECTING_DETAILS"
      }
    },
    {
      "message": "Mohammed",
      "expect": {
        "state": "COLLECTING_DETAILS"
      }
    },
    {
      "message": "0837866021",
      "expect": {
        "state": "COLLECTING_DETAILS",
        "response_contains": ["special instructions"]
      }
    },
    {
      "message": "skip",
      "expect": {
        "state": "ORDER_PLACED",
        "cart": []
      }
    }
  ],

  "final_order": {
    "items": [{"name": "Cappuccino", "quantity": 1, "special_instructions": "oat milk"}],
    "subtotal_cents": 4500,
    "total_cents": 4500,
    "order_mode": "PICKUP",
    "customer_name": "Mohammed"
  }
}
