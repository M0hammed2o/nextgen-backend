# ═══════════════════════════════════════════════════════════════════════════════
# NextGen AI Platform — Backend (.env.backend)
# Model 1: Single WABA, Multiple Phone Numbers
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────────────
DEBUG=true
# SQLAlchemy statement echo — DELIBERATELY SEPARATE from DEBUG (KNOWN_BUGS.md
# BUG-0085). Logs every SQL statement's bound parameters verbatim, including
# real customer PII when set against a real database (Customer.wa_id/
# phone_number, DigitalReceipt.phone_number_e164). Safe to flip to `true`
# locally when actually debugging a query; refused outright at boot in
# staging/production regardless of this file. Defaults false even here.
SQL_ECHO_ENABLED=false
ENVIRONMENT=development
ALLOWED_ORIGINS=https://nextgenintelligence.co.za,https://app.nextgenintelligence.co.za,https://staff.nextgenintelligence.co.za,https://admin.nextgenintelligence.co.za,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8080,http://localhost:8081,http://localhost:8083

# ── Database / Redis ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/nextgen
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://redis:6379/0

# ── JWT (generate real keys for production) ──────────────────────────────────
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_ADMIN_SECRET_KEY signs SUPER_ADMIN tokens and MUST differ from
# JWT_SECRET_KEY — production startup refuses to boot otherwise.
JWT_SECRET_KEY=CHANGE-ME-generate-a-strong-random-string
JWT_ADMIN_SECRET_KEY=CHANGE-ME-generate-a-different-strong-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
STAFF_ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Credential encryption (payment provider keys at rest) ────────────────────
# Fernet key — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in production. Do NOT rotate casually — stored credentials become
# unreadable if the key changes (businesses would need to re-enter keys).
CREDENTIALS_ENCRYPTION_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# META / WHATSAPP (Model 1: Single WABA, Platform Token)
#
# Architecture:
#   ONE Meta App → ONE WhatsApp Business Account (WABA)
#   ONE System User Access Token (long-lived, from Meta Business Manager)
#   MULTIPLE phone_number_id values (one per client business, stored in DB)
#
# The access token is platform-level, NOT per-business.
# Each business only has a whatsapp_phone_number_id in the businesses table.
# ═══════════════════════════════════════════════════════════════════════════════
WHATSAPP_DEFAULT_ACCESS_TOKEN=your_system_user_access_token_here
META_VERIFY_TOKEN=your_webhook_verify_token
META_APP_SECRET=your_meta_app_secret
META_API_VERSION=v22.0
META_API_BASE_URL=https://graph.facebook.com
WHATSAPP_WEBHOOK_PATH=/v1/webhook/meta

# ── Meta Embedded Signup — customer-owned WhatsApp (Wave 0A / Milestone C /
#    DECISION-0022). ADDITIVE to Model 1 above — every existing business
#    keeps working on the platform token unchanged. Both OPTIONAL: when
#    either is unset, GET /v1/business/whatsapp/connection/config reports
#    {"available": false} instead of crashing boot. Public identifiers only
#    (safe to send to the frontend to launch FB.login) — the actual secret
#    exchanged for a per-business token is META_APP_SECRET above, which
#    never leaves the backend.
META_APP_ID=
META_ES_CONFIG_ID=

# Optional comma-separated list of PREVIOUSLY-used CREDENTIALS_ENCRYPTION_KEY
# values — decrypt-only, used when rotating the primary key above so
# already-encrypted rows (payment credentials, and per-business WhatsApp
# tokens on whatsapp_connections) keep decrypting. See
# backend/app/core/crypto.py.
CREDENTIALS_ENCRYPTION_KEYS_OLD=

# ── NextGen's own SaaS subscription billing of tenants (distinct from the
#    customer-facing payment providers below, which are how a TENANT's own
#    customers pay the tenant) ─────────────────────────────────────────────
BILLING_PROVIDER=STRIPE
# STRIPE | PAYFAST — which BillingProvider actively handles it (config
# change only, never a code change — see backend/app/billing/registry.py)
BILLING_ENABLED=true
# Set false to defer NextGen's own SaaS billing entirely (e.g. before a
# chosen provider's real merchant credentials are ready) — skips only the
# billing-secret checks in production, every other secret is still enforced.

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# One recurring Stripe Price ID per self-service plan tier (ENTERPRISE is
# deliberately excluded — sales-assisted/custom-contract only, never
# self-service Checkout, per PRODUCT_ROADMAP.md).
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_GROWTH=
# Where Stripe Checkout/Billing Portal send the owner back to afterward.
BILLING_SUCCESS_URL=https://app.nextgenintelligence.co.za/settings/billing?checkout=success
BILLING_CANCEL_URL=https://app.nextgenintelligence.co.za/settings/billing?checkout=cancelled
BILLING_PORTAL_RETURN_URL=https://app.nextgenintelligence.co.za/settings/billing

# ── NextGen's OWN PayFast merchant account for SaaS billing (only used if
#    BILLING_PROVIDER=PAYFAST) — distinct from a tenant's own PayFast
#    credentials for their customers' payments. Unverified against live
#    credentials, see KNOWN_BUGS.md. ──────────────────────────────────────
PAYFAST_BILLING_MERCHANT_ID=
PAYFAST_BILLING_MERCHANT_KEY=
PAYFAST_BILLING_PASSPHRASE=

# ── Commercial / sales-onboarding trials (Wave 0A) ────────────────────────────
TRIAL_DEFAULT_DAYS=14
ONBOARDER_MAX_TRIAL_EXTENSION_DAYS=14
TRIAL_EXPIRY_GRACE_DAYS=3

# ── NextGen's own commercial-invoice (EFT/cash) details — printed ONLY inside
#    an issued invoice PDF, never returned by any settings/config API. Issuing
#    an invoice is refused (409 INVOICING_NOT_CONFIGURED) while any required
#    value below is unset — see backend/app/billing/commercial_invoices.py. ──
NEXTGEN_VAT_REGISTERED=false
NEXTGEN_VAT_NUMBER=
NEXTGEN_VAT_RATE_BPS=1500
NEXTGEN_LEGAL_NAME=
NEXTGEN_TRADING_NAME=
NEXTGEN_REGISTRATION_NUMBER=
NEXTGEN_ADDRESS=
NEXTGEN_CONTACT_EMAIL=
NEXTGEN_CONTACT_PHONE=
NEXTGEN_BANK_NAME=
NEXTGEN_BANK_ACCOUNT_NAME=
NEXTGEN_BANK_ACCOUNT_NUMBER=
NEXTGEN_BANK_BRANCH_CODE=
NEXTGEN_BANK_ACCOUNT_TYPE=
NEXTGEN_INVOICE_PAYMENT_TERMS_DAYS=7

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.3

# ── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_STORAGE_BUCKET=nextgen-assets

# ── Payment provider callbacks ───────────────────────────────────────────────
# Must be this API's real, currently-live public host — iKhoka/PayFast POST
# their payment-confirmation webhook here. Verify with `curl <value>/health`
# before deploying; a stale value here silently loses real payment
# confirmations (see KNOWN_BUGS.md BUG-0012).
BACKEND_PUBLIC_URL=https://api.nextgenintelligence.co.za
PAYMENT_RETURN_URL=https://nextgenintelligence.co.za/payment/success
PAYMENT_CANCEL_URL=https://nextgenintelligence.co.za/payment/cancelled

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=5
PIN_RATE_LIMIT_PER_MINUTE=10
REFRESH_RATE_LIMIT_PER_MINUTE=30
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30
CUSTOMER_MESSAGE_RATE_PER_MINUTE=10

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate once with:
#   python -c "from py_vapid import Vapid; import base64; v=Vapid(); v.generate_keys();
#     print('VAPID_PRIVATE_KEY=' + base64.b64encode(v.private_pem()).decode());
#     print('VAPID_PUBLIC_KEY=' + v.public_key.serialize().decode())"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@nextgenintelligence.co.za
